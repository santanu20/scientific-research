{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/santanu20/scientific-research/blob/master/schemas/research-bundle-v1.schema.json",
  "title": "Scientific Research Evidence Bundle v1",
  "description": "Versioned, provider-neutral research protocol, acquisition log, source, evidence, claim, and relationship envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "search_executions",
    "sources",
    "evidence_spans",
    "claims",
    "relationships"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "search_executions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/search_execution"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "evidence_spans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_span"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "research_question",
        "created_at_utc",
        "inclusion_criteria",
        "exclusion_criteria",
        "planned_sources"
      ],
      "properties": {
        "protocol_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "research_question": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "created_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "inclusion_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "exclusion_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "planned_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "registered",
            "amended",
            "completed"
          ]
        },
        "preregistration_uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "search_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "provider",
        "exact_query",
        "executed_at_utc",
        "result_count",
        "parameters",
        "export_sha256"
      ],
      "properties": {
        "execution_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "provider": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "exact_query": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "executed_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "result_count": {
          "type": "integer",
          "minimum": 0
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "export_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "provider",
        "title",
        "retrieved_at_utc",
        "provider_record_id",
        "doi",
        "url",
        "publication_year",
        "content_sha256"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "provider": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "retrieved_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "provider_record_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "publication_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1450,
          "maximum": 9999
        },
        "content_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_id",
        "quote",
        "source_sha256",
        "locator",
        "page_number",
        "section",
        "char_start",
        "char_end"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "quote": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "page_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "char_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "char_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement",
        "kind",
        "created_at_utc"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "type": "string",
          "enum": [
            "finding",
            "interpretation",
            "hypothesis",
            "limitation",
            "recommendation"
          ]
        },
        "created_at_utc": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "evidence_id",
        "relation",
        "rationale",
        "review_status",
        "reviewer_id"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "relation": {
          "type": "string",
          "enum": [
            "supports",
            "refutes",
            "qualifies",
            "contextualizes"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "review_status": {
          "type": "string",
          "enum": [
            "unreviewed",
            "human_reviewed"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}\n